<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Interfaces\BilliardsGame.Interfaces.csproj" />
    <ProjectReference Include="..\Physics\BilliardsGame.Physics.csproj" />
    <ProjectReference Include="..\Core\BilliardsGame.Core.csproj" />
    <ProjectReference Include="..\Network\BilliardsGame.Network.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="..\Assets\Audio\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Audio\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    <None Update="..\Assets\icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>icon.png</Link>
    </None>
  </ItemGroup>
</Project>
